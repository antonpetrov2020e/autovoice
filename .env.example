# Groq API ключ (получить БЕСПЛАТНО на https://console.groq.com/keys)
GROQ_API_KEY=your_api_key_here

# Модель для транскрипции (Whisper Large v3 Turbo - быстрая и точная)
# Другие варианты:
# - whisper-large-v3 (более точная, но медленнее)
# - distil-whisper-large-v3-en (только английский, быстрее)
TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Путь к папке с записями Voice Memos
VOICE_MEMOS_PATH=/Users/viktorivanov/Library/Application Support/com.apple.voicememos/Recordings

# Путь к папке Obsidian для сохранения транскрипций
OBSIDIAN_VAULT_PATH=/Users/viktorivanov/Documents/Obsidian/MyVault/Daily Diary

# Язык для транскрипции (ru для русского, en для английского)
TRANSCRIPTION_LANGUAGE=ru

# Улучшение текста после транскрипции (true/false)
# Если включено, текст будет автоматически отредактирован:
# - Исправлены опечатки и грамматика
# - Расставлена пунктуация
# - Разбит на смысловые абзацы
IMPROVE_TEXT=true

# Извлечение задач и напоминаний из дневника (true/false)
# Если включено, система автоматически:
# - Извлекает задачи и дела из голосовых заметок
# - Собирает важные напоминания
# - Создает единый файл с задачами, организованный по месяцам и дням
EXTRACT_TASKS=true

# Путь к файлу с задачами (можно указать путь внутри Obsidian)
# По умолчанию создается в корне проекта
# Например: /Users/viktorivanov/Documents/Obsidian/MyVault/Задачи из дневника.md
TASKS_FILE_PATH=Задачи из дневника.md
